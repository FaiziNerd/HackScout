# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.log
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/src/generated/

# vercel / local deploy
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor (local only)
.idea/
.vscode/
*.swp
*.swo

# Cursor local state (keep project skills in .agents/)
.cursor/

# OS / temp
tmp/
temp/
.cache/
