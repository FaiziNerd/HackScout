# PostgreSQL — use the Supabase URI from Project Settings → Database
# Session/direct (port 5432, db.<project>.supabase.co) is required for prisma migrate
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
# Transaction pooler (port 6543) is fine for the Next.js app at runtime
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth + client
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional: used in docs for production redirect allow-list
# Set this to the canonical production URL so Open Graph / sitemap / emails
# resolve to the live domain (not a Vercel preview URL).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated emails that can open /admin (spam take-down, missing tips, signups)
ADMIN_EMAILS=""

# Optional override for signing organizer publish links (falls back to CRON_SECRET)
PUBLISH_TOKEN_SECRET=""

# Resend — required for publish-confirm + deadline/digest emails
RESEND_API_KEY=""
DEADLINE_EMAIL_FROM="HackScout <alerts@your-verified-domain.com>"
# Vercel automatically sends this as a Bearer token to cron routes (also signs publish links)
CRON_SECRET=""

# Groq (LinkedIn extract — later)
GROQ_API_KEY=""

# Eventbrite public discovery pages (API search was retired in 2019)
# Defaults already cover Pakistan + major cities. Set LOCATION_SLUGS to replace that list.
# EVENTBRITE_LOCATION_SLUGS="pakistan,pakistan--karachi,pakistan--lahore"
EVENTBRITE_PAGE_URLS=""
EVENTBRITE_PAGE_LIMIT="3"

# Luma scraping
# Number of discover pages to crawl (https://lu.ma/discover?page=N)
LUMA_DISCOVER_PAGE_LIMIT="30"
# Optional extra page URLs or calendar URLs (comma-separated)
# Example Pakistan calendars:
# LUMA_PAGE_URLS="https://lu.ma/genai-collective,https://lu.ma/uetlahore?k=c"
LUMA_PAGE_URLS=""
# Optional comma-separated slugs (e.g. "pakistan,uetlahore,gdg-islamabad")
LUMA_CALENDAR_SLUGS=""
# Max event detail pages to hydrate for richer metadata
LUMA_DETAIL_FETCH_LIMIT="500"
# Set "true" to keep only Pakistan-related Luma events
LUMA_REQUIRE_PAKISTAN_MATCH="true"

# Facebook public event scraping
# Comma- or newline-separated public event URLs, e.g. https://www.facebook.com/events/1234567890
FACEBOOK_EVENT_URLS=""
# Public page URLs; the scraper also checks each page's /events tab for public event links.
# Starter list: major Pakistan universities + developer communities.
FACEBOOK_PAGE_URLS="https://www.facebook.com/nust.edu.pk,https://www.facebook.com/LUMS,https://www.facebook.com/fastnuces,https://www.facebook.com/giki.edu,https://www.facebook.com/COMSATS,https://www.facebook.com/NEDUETOfficial,https://www.facebook.com/IBAKarachi,https://www.facebook.com/gdgislamabad,https://www.facebook.com/gdglahore,https://www.facebook.com/gdgkarachi,https://www.facebook.com/gdgcloudislamabad,https://www.facebook.com/DSCNUST,https://www.facebook.com/gdscfast,https://www.facebook.com/gdsc.lums,https://www.facebook.com/gdscned,https://www.facebook.com/gdsc.iba"
FACEBOOK_PAGE_FETCH_LIMIT="20"
FACEBOOK_EVENT_FETCH_LIMIT="50"

# University calendars (NUST, LUMS, FAST, GIKI, COMSATS, IBA, NED)
# Defaults already point at each school's public events listing.
NUST_EVENT_API_URL=""
NUST_EVENT_PAGE_LIMIT="3"
LUMS_EVENTS_URL=""
GIKI_EVENTS_API_URL=""
COMSATS_EVENTS_URL=""
IBA_EVENTS_URL=""
IBA_CDC_EVENTS_URL=""
NED_EVENTS_URL=""
NED_CSIT_EVENTS_URL=""
NED_TECHFEST_URL=""

# Unstop public search API (hackathons, competitions, workshops, conferences)
UNSTOP_PAGE_LIMIT="4"
UNSTOP_PER_PAGE="50"

# Redis TCP/TLS connection used by BullMQ.
# Upstash: copy the ioredis/TLS URL (`rediss://...`), not the REST URL/token.
REDIS_URL="rediss://default:PASSWORD@YOUR-ENDPOINT.upstash.io:6379"
# Long-running worker (Railway/Render): `npm run worker`
# Registers a 6-hour UTC schedule and processes scrape jobs. Vercel cron
# `/api/cron/scrapers` enqueues the same job as a backup kick.
