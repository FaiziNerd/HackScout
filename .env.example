# PostgreSQL — use the Supabase URI from Project Settings → Database
# Session/direct (port 5432, db.<project>.supabase.co) is required for prisma migrate
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
# Transaction pooler (port 6543) is fine for the Next.js app at runtime
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth + client
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (deadline emails — later)
RESEND_API_KEY=""

# OpenAI (LinkedIn extract — later)
OPENAI_API_KEY=""

# Upstash Redis (BullMQ worker — later)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
