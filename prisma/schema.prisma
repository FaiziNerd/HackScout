// HackScout — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventCategory {
  hackathon
  conference
  workshop
  meetup
  competition
  seminar
  career_fair
  festival
  other
}

enum EventSource {
  devfolio
  devpost
  talentshowcase
  eventbrite
  luma
  unstop
  hackerearth
  facebook
  university
  linkedin
  instagram
  community
  admin
}

enum EventStatus {
  upcoming
  ongoing
  closed
}

enum RegistrationType {
  external
  native
}

enum ScrapeStatus {
  success
  failed
  partial
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model City {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  province   String?
  country    String  @default("Pakistan")
  eventCount Int     @default(0)
  isVirtual  Boolean @default(false)
  events     Event[]
}

model User {
  id               String         @id
  email            String         @unique
  name             String?
  preferredCityIds String[]       @default([])
  createdAt        DateTime       @default(now())
  savedEvents      SavedEvent[]
  registrations    Registration[]
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
}

model ScrapeLog {
  id          String      @id @default(cuid())
  source      EventSource
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  status      ScrapeStatus
  eventsFound Int         @default(0)
  error       String?
}

model Event {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  description          String
  coverImage           String?
  category             EventCategory
  country              String           @default("Pakistan")
  source               EventSource
  sources              EventSource[]    @default([])
  sourcePostUrl        String?
  sourceUrl            String
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  cityId               String
  city                 City             @relation(fields: [cityId], references: [id])
  venue                String?
  isOnline             Boolean          @default(false)
  tags                 String[]         @default([])
  prizePool            String?
  organizerName        String?
  registrationType     RegistrationType @default(external)
  registrationUrl      String?
  status               EventStatus      @default(upcoming)
  reviewStatus         ReviewStatus     @default(approved)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lastScrapedAt        DateTime?
  savedEvents          SavedEvent[]
  registrations        Registration[]

  @@index([cityId])
  @@index([registrationDeadline])
  @@index([status])
  @@index([reviewStatus])
}
